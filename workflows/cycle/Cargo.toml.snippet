# Paste into Cargo.toml.
#
# Workspace: put the two tables below under [workspace.lints.rust] and
# [workspace.lints.clippy] in the root Cargo.toml, and give every member
# crate:
#
#     [lints]
#     workspace = true

[lints.rust]
# Agents may not add `unsafe` (CLAUDE.md). Warn, not forbid: the owner
# may need it in a hot path and decides per site.
unsafe_code = "warn"
missing_docs = "warn"

[lints.clippy]
# No mod.rs. A module is `foo.rs` with its children in `foo/`.
mod_module_files = "deny"
self_named_module_files = "allow"

# The step-4 contract leaves `todo!()` bodies. "Clippy clean" (QA.md)
# therefore also means: no stub left behind at step 6.
todo = "warn"
unimplemented = "warn"
dbg_macro = "warn"

# Pedantic on, at lower priority so the lines above win.
pedantic = { level = "warn", priority = -1 }
# Pedantic items that fight the contract style.
module_name_repetitions = "allow"
must_use_candidate = "allow"
